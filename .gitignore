# --- Source repos cloned at runtime (scripts/clone_repos.sh, tasks/*/setup.sh) ---
# These are large and have their own git history; they are NOT part of this repo.
/repos/

# --- Python caches / build artifacts ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Training outputs ---
# Keep the shipped pre-trained model, ignore everything else students generate.
tasks/*/models/*.zip
!tasks/hovering/models/hover_PPO.zip
!tasks/circle/models/hover_PPO.zip
!tasks/circle/models/track_PPO.zip
tasks/*/models/*.pt
**/tensorboard/
*.log

# --- Racing task (vendored crazy_track) ---
# Training/eval runs write into results/ inside the vendored source tree
# (crazy_track's RunLogger resolves paths relative to its own repo root).
tasks/racing/crazy_track/results/*
# ...except the Lesson 9 study's training runs: METHODOLOGY.md cites these checkpoints as evidence.
!tasks/racing/crazy_track/results/*_racing-gate-aware*/
# Lesson 9 run logs are kept as evidence (the global *.log rule above would drop them)
!tasks/racing/code/lesson9/results/**/*.log

# --- Editor / OS noise ---
.vscode/
.idea/
.DS_Store
tasks/racing/code/lesson9/session_summary_2026-10-17.md
tasks/racing/code/lesson9/study_methodology.txt
