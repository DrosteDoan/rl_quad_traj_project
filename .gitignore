# --- Source repos cloned at runtime (scripts/clone_repos.sh, tasks/*/setup.sh) ---
# These are large and have their own git history; they are NOT part of this repo.
/repos/

# --- Python caches / build artifacts ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Training outputs ---
# Keep the shipped pre-trained model, ignore everything else students generate.
tasks/*/models/*.zip
!tasks/hovering/models/hover_PPO.zip
!tasks/circle/models/hover_PPO.zip
!tasks/circle/models/track_PPO.zip
tasks/*/models/*.pt
**/tensorboard/
*.log

# --- Racing task (vendored crazy_track) ---
# Training/eval runs write into results/ inside the vendored source tree
# (crazy_track's RunLogger resolves paths relative to its own repo root).
tasks/racing/crazy_track/results/
tasks/racing/figures/
# TOGT plans (Lesson 6) are generated by tasks/racing/code/togt_plan.py
tasks/racing/plans/

# --- Editor / OS noise ---
.vscode/
.idea/
.DS_Store
